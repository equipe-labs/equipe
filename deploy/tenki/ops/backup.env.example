# The backup target, as Tenki renders it into a new sandbox:
#
#   tenki sandbox create ... --secret-file deploy/tenki/ops/backup.env.example:/home/tenki/.config/equipe-ops/backup.env
#
# (migrate.sh passes this file for you with --via backup.) Each secrets://NAME is
# replaced with the workspace secret NAME when the sandbox starts; this file
# itself holds no secret and is safe to commit. Create the secrets once:
#
#   tenki secrets create EQUIPE_BACKUP_RESTIC_PASSWORD      # hidden prompt; keep a copy offline
#   tenki secrets create EQUIPE_BACKUP_S3_ACCESS_KEY_ID
#   tenki secrets create EQUIPE_BACKUP_S3_SECRET_ACCESS_KEY
#
# The restic password encrypts every backup. Lose it and the backups can't be
# read by anyone, including you: store it in your password manager as well.

# Any restic repository. S3-compatible examples:
#   Cloudflare R2:  s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>/equipe
#   Amazon S3:      s3:s3.amazonaws.com/<bucket>/equipe
#   Backblaze B2:   s3:https://s3.<region>.backblazeb2.com/<bucket>/equipe
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/BUCKET/equipe
RESTIC_PASSWORD=secrets://EQUIPE_BACKUP_RESTIC_PASSWORD
AWS_ACCESS_KEY_ID=secrets://EQUIPE_BACKUP_S3_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=secrets://EQUIPE_BACKUP_S3_SECRET_ACCESS_KEY
# R2 takes "auto"; S3 takes the bucket's region.
AWS_DEFAULT_REGION=auto
# One lineage of snapshots per deployment, whichever sandbox made them.
EQUIPE_OPS_HOST=equipe-prod
