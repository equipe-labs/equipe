# Everything the image downloads from outside the Ubuntu archive, pinned.
# Bump a version and its checksum together; provision.sh refuses a mismatch.
# Ubuntu packages come from the signed archive at whatever 24.04 ships.

# equipe, from the project's own GitHub release (the same archive install.sh
# installs). Checksums are the release's SHA256SUMS lines.
EQUIPE_VERSION=0.103.117
EQUIPE_SHA256_X86_64=a07cd2ba546d16d365c1b264e363e0ca37e0f962c5532a9cc499fa4e171249ae
EQUIPE_SHA256_AARCH64=7bf7d14021bc5b6915951b126b8bed5f87768bb9ef83919ffb159b0ec5f2e3e5

# Google Chrome comes from Google's signed apt repository. This pins the
# fingerprint of the key that signs it; provision.sh checks the downloaded key.
GOOGLE_LINUX_SIGNING_KEY_FPR=EB4C1BFD4F042F6DDDCCEC917721F63BD38B4796
