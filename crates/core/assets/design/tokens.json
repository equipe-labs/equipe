{
  "color": {
    "$type": "color",
    "neutral": {
      "0": { "$value": "#FFFFFF" },
      "50": { "$value": "#F7F7F8" },
      "100": { "$value": "#EEEEF0" },
      "200": { "$value": "#DCDCE0" },
      "400": { "$value": "#9A9AA3" },
      "500": { "$value": "#6E6E78" },
      "700": { "$value": "#3A3A42" },
      "900": { "$value": "#16161A" },
      "950": { "$value": "#0C0C0F" }
    },
    "brand": {
      "500": { "$value": "#1F6FEB", "$description": "Replace with the brand's own colour — from the audit or the chosen direction." },
      "600": { "$value": "#1A5FCC" }
    },
    "red": { "600": { "$value": "#D92D20" } },
    "green": { "600": { "$value": "#14804A" } },
    "bg": { "$value": "{color.neutral.0}", "$extensions": { "mode": { "dark": "#0C0C0F" } } },
    "surface": {
      "default": { "$value": "{color.neutral.0}", "$extensions": { "mode": { "dark": "#16161A" } } },
      "sunken": { "$value": "{color.neutral.50}", "$extensions": { "mode": { "dark": "#111114" } } }
    },
    "border": {
      "default": { "$value": "{color.neutral.200}", "$extensions": { "mode": { "dark": "#2A2A31" } } }
    },
    "text": {
      "primary": { "$value": "{color.neutral.900}", "$extensions": { "mode": { "dark": "#F2F2F4" } } },
      "secondary": { "$value": "{color.neutral.500}", "$extensions": { "mode": { "dark": "#A3A3AD" } } }
    },
    "action": {
      "primary": { "$value": "{color.brand.500}", "$extensions": { "mode": { "dark": "#4C8DF6" } } },
      "onPrimary": { "$value": "{color.neutral.0}", "$extensions": { "mode": { "dark": "#0C0C0F" } } }
    },
    "danger": { "$value": "{color.red.600}", "$extensions": { "mode": { "dark": "#F97066" } } },
    "success": { "$value": "{color.green.600}", "$extensions": { "mode": { "dark": "#47CD89" } } }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["Pretendard", "Apple SD Gothic Neo", "system-ui", "sans-serif"] },
    "mono": { "$value": ["JetBrains Mono", "Menlo", "monospace"] }
  },
  "type": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.sans}", "fontSize": "32px", "fontWeight": 700, "lineHeight": 1.3, "letterSpacing": "-0.02em" } },
    "title": { "$value": { "fontFamily": "{font.sans}", "fontSize": "20px", "fontWeight": 600, "lineHeight": 1.4, "letterSpacing": "-0.01em" } },
    "body": { "$value": { "fontFamily": "{font.sans}", "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.6, "letterSpacing": "0em" } },
    "caption": { "$value": { "fontFamily": "{font.sans}", "fontSize": "12px", "fontWeight": 500, "lineHeight": 1.5, "letterSpacing": "0em" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "full": { "$value": "999px" }
  },
  "shadow": {
    "$type": "shadow",
    "raised": { "$value": { "color": "#0000001A", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" } },
    "overlay": { "$value": { "color": "#00000029", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" } }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "base": { "$type": "duration", "$value": "200ms" },
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "button": {
    "primary": {
      "bg": { "$type": "color", "$value": "{color.action.primary}" },
      "text": { "$type": "color", "$value": "{color.action.onPrimary}" },
      "radius": { "$type": "dimension", "$value": "{radius.md}" }
    }
  }
}
