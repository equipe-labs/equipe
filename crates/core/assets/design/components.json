    { "name": "switch", "set": "core", "pattern": "switch", "target": "[role=switch], button", "states": ["default", "hover", "focus-visible", "checked", "disabled"], "keyboard": ["tab-reaches", "focus-visible", "space-activates", "disabled-skipped"], "replaces": ["[role=switch]"] },
