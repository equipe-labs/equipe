{
  "about": "What equipe knows of each component a design system's registry is expected to have: the WAI-ARIA pattern it follows, the interactive part an example holds, the states its docs page shows, the keyboard behaviour it must have, how it opens, and the raw markup in product code it replaces. Extend it by adding an entry; `states`, `keyboard` and `open.how` take only the words defined below. `set` is `core` for the components a full system has (counted in coverage) and `extra` for newer ones counted when present.",
  "states": {
    "default": "as it first draws",
    "hover": "the pointer over it",
    "focus-visible": "reached by the keyboard",
    "active": "pressed",
    "disabled": "disabled",
    "error": "invalid (aria-invalid)",
    "checked": "checked, on or selected",
    "open": "open, showing what it opens"
  },
  "keyboard": {
    "tab-reaches": "Tab reaches it",
    "focus-visible": "focus shows when the keyboard reaches it",
    "enter-activates": "Enter activates it",
    "space-activates": "Space activates or toggles it",
    "esc-closes": "Esc closes what it opened",
    "focus-moves-in": "opening it moves focus inside what opened",
    "focus-returns": "closing it puts focus back on what opened it",
    "focus-trapped": "while it is open, Tab stays inside it",
    "arrows-move": "the arrow keys move between its items",
    "arrows-change": "the arrow keys change its value",
    "home-end": "Home and End go to the first and last",
    "disabled-skipped": "Tab passes over it when it is disabled"
  },
  "components": [
    { "name": "accordion", "set": "core", "pattern": "accordion", "target": "button[aria-expanded], [data-slot=accordion-trigger]", "states": ["default", "hover", "focus-visible", "open", "disabled"], "keyboard": ["tab-reaches", "focus-visible", "enter-activates", "space-activates"], "replaces": ["details"] },
    { "name": "alert", "set": "core", "pattern": "alert", "states": ["default"], "keyboard": [], "replaces": ["styled [role=alert]"] },
    { "name": "alert-dialog", "set": "core", "pattern": "alertdialog", "target": "button, [role=button]", "open": { "how": "click", "surface": "[role=alertdialog], [role=dialog]" }, "states": ["default", "focus-visible", "open"], "keyboard": ["tab-reaches", "focus-visible", "enter-activates", "focus-moves-in", "focus-trapped", "esc-closes", "focus-returns"], "replaces": ["[role=alertdialog]"] },
    { "name": "aspect-ratio", "set": "core", "pattern": "none", "states": ["default"], "keyboard": [] },
    { "name": "avatar", "set": "core", "pattern": "img", "states": ["default"], "keyboard": [] },
    { "name": "badge", "set": "core", "pattern": "none", "states": ["default"], "keyboard": [] },
    { "name": "breadcrumb", "set": "core", "pattern": "breadcrumb", "target": "a[href]", "states": ["default", "hover", "focus-visible"], "keyboard": ["tab-reaches", "focus-visible"], "replaces": ["nav[aria-label~=breadcrumb]"] },
    { "name": "button", "set": "core", "pattern": "button", "target": "button, [role=button], a[href]", "states": ["default", "hover", "focus-visible", "active", "disabled"], "keyboard": ["tab-reaches", "focus-visible", "enter-activates", "space-activates", "disabled-skipped"], "replaces": ["styled button", "styled input[type=button|submit|reset]"] },
    { "name": "calendar", "set": "core", "pattern": "grid", "target": "[role=grid] button, button[name=day], td button", "states": ["default", "hover", "focus-visible", "checked", "disabled"], "keyboard": ["tab-reaches", "focus-visible", "arrows-move", "enter-activates"] },
    { "name": "card", "set": "core", "pattern": "none", "states": ["default"], "keyboard": [] },
    { "name": "carousel", "set": "core", "pattern": "carousel", "target": "button", "states": ["default", "hover", "focus-visible", "disabled"], "keyboard": ["tab-reaches", "focus-visible", "enter-activates"] },
    { "name": "chart", "set": "core", "pattern": "img", "states": ["default"], "keyboard": [] },
    { "name": "checkbox", "set": "core", "pattern": "checkbox", "target": "[role=checkbox], input[type=checkbox]", "states": ["default", "hover", "focus-visible", "checked", "disabled", "error"], "keyboard": ["tab-reaches", "focus-visible", "space-activates", "disabled-skipped"], "replaces": ["input[type=checkbox]", "[role=checkbox]"] },
    { "name": "collapsible", "set": "core", "pattern": "disclosure", "target": "button[aria-expanded], [data-slot=collapsible-trigger]", "states": ["default", "focus-visible", "open"], "keyboard": ["tab-reaches", "focus-visible", "enter-activates", "space-activates"], "replaces": ["details"] },
    { "name": "combobox", "set": "core", "pattern": "combobox", "target": "[role=combobox], button[aria-expanded]", "open": { "how": "click", "surface": "[role=listbox], [role=dialog], [cmdk-list]" }, "states": ["default", "hover", "focus-visible", "open", "disabled"], "keyboard": ["tab-reaches", "focus-visible", "enter-activates", "focus-moves-in", "arrows-move", "esc-closes", "focus-returns"], "replaces": ["[role=combobox]", "input[list]"] },
    { "name": "command", "set": "core", "pattern": "listbox", "target": "input, [cmdk-input]", "states": ["default", "focus-visible"], "keyboard": ["tab-reaches", "focus-visible", "arrows-move"] },
    { "name": "context-menu", "set": "core", "pattern": "menu", "target": "[data-slot=context-menu-trigger], [data-state]", "open": { "how": "contextmenu", "surface": "[role=menu]" }, "states": ["default", "open"], "keyboard": ["arrows-move", "esc-closes"] },
    { "name": "data-table", "set": "core", "pattern": "table", "target": "button, input, [role=checkbox]", "states": ["default", "hover", "focus-visible"], "keyboard": ["tab-reaches", "focus-visible"] },
    { "name": "date-picker", "set": "core", "pattern": "dialog", "target": "button", "open": { "how": "click", "surface": "[role=dialog], [role=grid]" }, "states": ["default", "hover", "focus-visible", "open", "disabled"], "keyboard": ["tab-reaches", "focus-visible", "enter-activates", "focus-moves-in", "esc-closes", "focus-returns"], "replaces": ["styled input[type=date|datetime-local]"] },
    { "name": "dialog", "set": "core", "pattern": "dialog", "target": "button, [role=button]", "open": { "how": "click", "surface": "[role=dialog]" }, "states": ["default", "focus-visible", "open"], "keyboard": ["tab-reaches", "focus-visible", "enter-activates", "focus-moves-in", "focus-trapped", "esc-closes", "focus-returns"], "replaces": ["dialog", "[role=dialog]", "[aria-modal]"] },
    { "name": "drawer", "set": "core", "pattern": "dialog", "target": "button, [role=button]", "open": { "how": "click", "surface": "[role=dialog]" }, "states": ["default", "focus-visible", "open"], "keyboard": ["tab-reaches", "focus-visible", "enter-activates", "focus-moves-in", "esc-closes", "focus-returns"] },
    { "name": "dropdown-menu", "set": "core", "pattern": "menu-button", "target": "button[aria-haspopup], [aria-haspopup=menu], button", "open": { "how": "click", "surface": "[role=menu]" }, "states": ["default", "hover", "focus-visible", "open"], "keyboard": ["tab-reaches", "focus-visible", "enter-activates", "focus-moves-in", "arrows-move", "esc-closes", "focus-returns"], "replaces": ["[role=menu]"] },
    { "name": "form", "set": "core", "pattern": "form", "target": "input, textarea, button", "states": ["default", "focus-visible", "error", "disabled"], "keyboard": ["tab-reaches", "focus-visible"] },
    { "name": "hover-card", "set": "core", "pattern": "none", "target": "a[href], button", "open": { "how": "hover", "surface": "[data-slot=hover-card-content], [data-radix-popper-content-wrapper]" }, "states": ["default", "focus-visible", "open"], "keyboard": ["tab-reaches", "focus-visible"] },
    { "name": "input", "set": "core", "pattern": "textbox", "target": "input", "states": ["default", "hover", "focus-visible", "disabled", "error"], "keyboard": ["tab-reaches", "focus-visible", "disabled-skipped"], "replaces": ["styled input[type=|text|email|password|search|tel|url|number]"] },
    { "name": "input-otp", "set": "core", "pattern": "textbox", "target": "input", "states": ["default", "focus-visible", "disabled", "error"], "keyboard": ["tab-reaches", "focus-visible"] },
    { "name": "label", "set": "core", "pattern": "none", "states": ["default"], "keyboard": [], "replaces": ["styled label"] },
    { "name": "menubar", "set": "core", "pattern": "menubar", "target": "[role=menubar] [role=menuitem], [role=menuitem]", "open": { "how": "click", "surface": "[role=menu]" }, "states": ["default", "hover", "focus-visible", "open"], "keyboard": ["tab-reaches", "focus-visible", "arrows-move", "enter-activates", "esc-closes"], "replaces": ["[role=menubar]"] },
    { "name": "navigation-menu", "set": "core", "pattern": "disclosure-navigation", "target": "button[aria-expanded], a[href]", "open": { "how": "click", "surface": "[data-slot=navigation-menu-content], [data-radix-navigation-menu-viewport]" }, "states": ["default", "hover", "focus-visible", "open"], "keyboard": ["tab-reaches", "focus-visible", "enter-activates", "esc-closes"] },
    { "name": "pagination", "set": "core", "pattern": "navigation", "target": "a[href], button", "states": ["default", "hover", "focus-visible", "checked", "disabled"], "keyboard": ["tab-reaches", "focus-visible"], "replaces": ["nav[aria-label~=pagination]"] },
    { "name": "popover", "set": "core", "pattern": "dialog", "target": "button, [role=button]", "open": { "how": "click", "surface": "[role=dialog], [data-slot=popover-content]" }, "states": ["default", "focus-visible", "open"], "keyboard": ["tab-reaches", "focus-visible", "enter-activates", "focus-moves-in", "esc-closes", "focus-returns"], "replaces": ["[popover]"] },
    { "name": "progress", "set": "core", "pattern": "progressbar", "states": ["default"], "keyboard": [], "replaces": ["progress", "[role=progressbar]"] },
    { "name": "radio-group", "set": "core", "pattern": "radio", "target": "[role=radio], input[type=radio]", "states": ["default", "hover", "focus-visible", "checked", "disabled", "error"], "keyboard": ["tab-reaches", "focus-visible", "arrows-move", "space-activates"], "replaces": ["input[type=radio]", "[role=radiogroup]"] },
