    { "name": "separator", "set": "core", "pattern": "separator", "states": ["default"], "keyboard": [], "replaces": ["styled hr"] },
    { "name": "sheet", "set": "core", "pattern": "dialog", "target": "button, [role=button]", "open": { "how": "click", "surface": "[role=dialog]" }, "states": ["default", "focus-visible", "open"], "keyboard": ["tab-reaches", "focus-visible", "enter-activates", "focus-moves-in", "focus-trapped", "esc-closes", "focus-returns"] },
    { "name": "sidebar", "set": "core", "pattern": "navigation", "target": "a[href], button", "states": ["default", "hover", "focus-visible", "checked"], "keyboard": ["tab-reaches", "focus-visible", "enter-activates"] },
