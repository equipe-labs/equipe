{
  "color": {
    "$type": "color",
    "raw": {
      "ink": { "$value": "#15161A" },
      "bone": { "$value": "#F6F5F1" },
      "white": { "$value": "#FFFFFF" },
      "blue": { "$value": "#1D4ED8" },
      "grey": { "$value": "#4F5159" }
    },
    "text": { "$value": "{color.raw.ink}", "$extensions": { "mode": { "dark": "#EFEDE7" } } },
    "muted": { "$value": "{color.raw.grey}" },
    "bg": { "$value": "{color.raw.bone}", "$extensions": { "mode": { "dark": "#0A0A0C" } } },
    "surface": { "$value": "{color.raw.white}" },
    "accent": { "$value": "{color.raw.blue}" },
    "focus": { "$value": "{color.raw.blue}" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" }
  },
  "font": {
    "family": { "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] } },
    "size": {
      "$type": "dimension",
      "small": { "$value": "13px" },
      "body": { "$value": "15px" },
      "title": { "$value": "24px" },
      "display": { "$value": "32px" }
    }
  }
}
