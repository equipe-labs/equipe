{
  "name": "equipe",
  "version": "0.0.1",
  "description": "Spin up a full software squad of AI agents — PO, Designer, Frontend, Backend, QA, DevOps — coordinated over a shared board to build real, large-scale projects.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "equipe": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "orchestration",
    "agent-team",
    "acp",
    "codex",
    "coding-agent",
    "autonomous"
  ],
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
