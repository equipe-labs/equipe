{
  "$description": "equipe design system v1 — layer 1: primitives (raw values, no meaning). Never use these directly in product code; use the semantic layer (semantic.*.json) or component tokens. Source: T-144 brand guideline §2.2, §6; audit in audit.md.",
  "color": {
    "raw": {
      "$description": "layer 1: raw values. Only semantic tokens reference these. The warm neutral and the hues are the desktop palette as shipped on main (crates/desktop/src/theme.rs, T-699); numbers are (1 − OKLCH L) × 1000.",
      "neutral": {
        "$type": "color",
        "0":   { "$value": "#FFFFFF", "$description": "white" },
        "100": { "$value": "#EFEDE7", "$description": "bone — dark text, mark" },
        "950": { "$value": "#0A0A0C", "$description": "void — dark bg, icon tile" }
      },
      "warm": {
        "$type": "color",
        "$description": "one warm neutral (the brand Bone) — every grey on screen",
        "18":  { "$value": "#FAF9F6", "$description": "light bg" },
        "39":  { "$value": "#F3F2EF", "$description": "light sidebar" },
        "42":  { "$value": "#F2F1ED", "$description": "light code / sunken" },
        "43":  { "$value": "#F2F1EE", "$description": "light popover hover" },
        "44":  { "$value": "#F3F0E9", "$description": "dark text; tooltip text" },
        "55":  { "$value": "#EEEDE8", "$description": "light sidebar hover" },
        "63":  { "$value": "#ECEAE4", "$description": "dark primary action (bone)" },
        "76":  { "$value": "#E7E6E1", "$description": "light sidebar selected" },
        "87":  { "$value": "#E5E2DB", "$description": "dark prose" },
        "133": { "$value": "#D6D3CC", "$description": "dark primary pressed" },
        "166": { "$value": "#CCC8C2", "$description": "dark text-soft" },
        "170": { "$value": "#C9C7C2", "$description": "light switch off" },
        "272": { "$value": "#A9A7A1", "$description": "tooltip muted text" },
        "294": { "$value": "#A2A09A", "$description": "dark muted" },
        "350": { "$value": "#86847E", "$description": "light border-strong (3:1)" },
        "400": { "$value": "#77756F", "$description": "dark border-strong (3:1)" },
        "511": { "$value": "#62605A", "$description": "light muted" },
        "614": { "$value": "#45443E", "$description": "light text-soft" },
        "625": { "$value": "#42413E", "$description": "dark switch off" },
        "699": { "$value": "#2F2E2B", "$description": "dark popover hover" },
        "700": { "$value": "#2F2E2C", "$description": "dark tooltip" },
        "711": { "$value": "#2C2B27", "$description": "light primary hover" },
        "731": { "$value": "#272624", "$description": "dark sidebar selected" },
        "739": { "$value": "#252422", "$description": "dark popover" },
        "744": { "$value": "#24231F", "$description": "light prose" },
        "748": { "$value": "#232220", "$description": "light tooltip" },
        "765": { "$value": "#1F1E1C", "$description": "dark raised / surface" },
        "774": { "$value": "#1C1C1A", "$description": "dark sidebar hover" },
        "781": { "$value": "#1B1A19", "$description": "dark code / sunken" },
        "796": { "$value": "#181713", "$description": "light text; primary action" },
        "805": { "$value": "#151513", "$description": "dark bg" },
        "831": { "$value": "#100F0E", "$description": "dark sidebar" },
        "886": { "$value": "#050504", "$description": "light primary pressed" }
      },
      "blue": {
        "$type": "color",
        "300": { "$value": "#7EB8F3", "$description": "dark accent" },
        "500": { "$value": "#3F6FF5", "$description": "the brand dot (graphic only, not text)" },
        "600": { "$value": "#4378AD", "$description": "dark switch on — deep enough for a light knob" },
        "700": { "$value": "#2160AB", "$description": "light accent" }
      },
      "green": {
        "$type": "color",
        "300": { "$value": "#7FCB8E" },
        "700": { "$value": "#1F6B33" }
      },
      "amber": {
        "$type": "color",
        "300": { "$value": "#EABA67" },
        "700": { "$value": "#865901" }
      },
      "orange": {
        "$type": "color",
        "300": { "$value": "#FF7A45" },
        "700": { "$value": "#B83A0B" }
      },
      "red": {
        "$type": "color",
        "100": { "$value": "#EEE0DE", "$description": "light err fill (opaque)" },
        "150": { "$value": "#EBD9D7", "$description": "light err fill hover (100 + 4% red.700)" },
        "200": { "$value": "#E9D2CF", "$description": "light err fill pressed (100 + 8% red.700)" },
        "300": { "$value": "#F2857D" },
        "700": { "$value": "#AA2A27" },
        "850": { "$value": "#442E2E", "$description": "dark err fill pressed (900 + 8% red.300)" },
        "875": { "$value": "#3C2A2B", "$description": "dark err fill hover (900 + 4% red.300)" },
        "900": { "$value": "#352728", "$description": "dark err fill (opaque)" }
      },
      "member": {
        "$type": "color",
        "$description": "member and project colours: 300 = dark (OKLCH 0.80 0.11), 700 = light (OKLCH 0.49 0.12)",
        "0": {
          "300": { "$value": "#E3B667" },
          "700": { "$value": "#835600" }
        },
        "1": {
          "300": { "$value": "#F4A0C8" },
          "700": { "$value": "#943C6B" }
        },
        "2": {
          "300": { "$value": "#7FC5FF" },
          "700": { "$value": "#0065A4" }
        },
        "3": {
          "300": { "$value": "#89D298" },
          "700": { "$value": "#0D7435" }
        },
        "4": {
          "300": { "$value": "#C3B0FD" },
          "700": { "$value": "#674EA1" }
        },
        "5": {
          "300": { "$value": "#5AD5CB" },
          "700": { "$value": "#006F68" }
        },
        "6": {
          "300": { "$value": "#F7A97C" },
          "700": { "$value": "#984500" }
        },
        "7": {
          "300": { "$value": "#BBC671" },
          "700": { "$value": "#5F6700" }
        }
      },
      "alpha": {
        "$type": "color",
        "white-7":      { "$value": "#FFFFFF12", "$description": "dark hover wash" },
        "white-10":     { "$value": "#FFFFFF1A", "$description": "dark hairline" },
        "white-14":     { "$value": "#FFFFFF24", "$description": "dark pressed (wash × 2)" },
        "black-5":      { "$value": "#0000000C", "$description": "light hover wash" },
        "black-9":      { "$value": "#00000018", "$description": "light pressed (wash × 2)" },
        "black-10":     { "$value": "#0000001A" },
        "black-22":     { "$value": "#00000038" },
        "black-30":     { "$value": "#0000004D" },
        "black-40":     { "$value": "#00000066", "$description": "light scrim" },
        "black-60":     { "$value": "#00000099" },
        "blue300-12":   { "$value": "#7EB8F31F" },
        "blue700-8":    { "$value": "#2160AB14" },
        "green300-12":  { "$value": "#7FCB8E1F" },
        "green700-8":   { "$value": "#1F6B3314" },
        "amber300-12":  { "$value": "#EABA671F" },
        "amber700-8":   { "$value": "#86590114" },
        "orange300-12": { "$value": "#FF7A451F" },
        "orange700-8":  { "$value": "#B83A0B14" },
        "red300-12":    { "$value": "#F2857D1F" },
        "red700-8":     { "$value": "#AA2A2714" }
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base. 1-6 are for components; 7-9 are page rhythm (web sections).",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" },
    "7": { "$value": "48px" },
    "8": { "$value": "72px" },
    "9": { "$value": "112px" }
  },
  "radius": {
    "$type": "dimension",
    "sm":   { "$value": "6px" },
    "md":   { "$value": "8px" },
    "lg":   { "$value": "12px" },
    "xl":   { "$value": "16px" },
    "xxl":  { "$value": "24px" },
    "full": { "$value": "9999px" }
  },
  "border": {
    "$type": "dimension",
    "1": { "$value": "1px" },
    "2": { "$value": "2px" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter Variable", "Inter", "Pretendard Variable", "Noto Sans JP", "Noto Sans SC", "system-ui", "sans-serif"],
        "$description": "Web only. Apps use the platform font (SF Pro / Roboto) — guideline §3.2. Latin in Inter; a page in no one language gives each CJK script its own face (Hangul Pretendard, kana Noto Sans JP, Han only Chinese writes Noto Sans SC). A page that says its language (<html lang>) takes that script's stack from $extensions[\"im.equipe\"].lang, as :lang() in tokens.css.",
        "$extensions": {
          "im.equipe": {
            "lang": {
              "ko": ["Inter Variable", "Inter", "Pretendard Variable", "system-ui", "sans-serif"],
              "ja": ["Inter Variable", "Inter", "Hiragino Sans", "Noto Sans JP", "system-ui", "sans-serif"],
              "zh-Hans": ["Inter Variable", "Inter", "PingFang SC", "Noto Sans SC", "system-ui", "sans-serif"],
              "zh-Hant": ["Inter Variable", "Inter", "PingFang TC", "Noto Sans TC", "system-ui", "sans-serif"]
            }
          }
        }
      },
      "mono": { "$value": ["JetBrains Mono Variable", "JetBrains Mono", "ui-monospace", "Menlo", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "duration": {
    "$type": "duration",
    "0":    { "$value": "0ms" },
    "100":  { "$value": "100ms" },
    "120":  { "$value": "120ms" },
    "160":  { "$value": "160ms" },
    "180":  { "$value": "180ms" },
    "200":  { "$value": "200ms" },
    "5000": { "$value": "5000ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "out-cubic": { "$value": [0.215, 0.61, 0.355, 1], "$description": "1-(1-t)^3 — desktop motion.rs ease_out" },
    "out-quint": { "$value": [0.23, 1, 0.32, 1], "$description": "1-(1-t)^5 — panel slide" }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.4 }
  },
  "elevation": {
    "$type": "shadow",
    "float": {
      "$value": [
        { "color": "{color.raw.alpha.black-22}", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-4px" },
        { "color": "{color.raw.alpha.black-10}", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "0px" }
      ],
      "$description": "popover, menu, toast — desktop motion.rs float_shadow at full strength"
    },
    "overlay": {
      "$value": [
        { "color": "{color.raw.alpha.black-30}", "offsetX": "0px", "offsetY": "16px", "blur": "48px", "spread": "-8px" },
        { "color": "{color.raw.alpha.black-10}", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" }
      ],
      "$description": "modal dialog, bottom sheet — NEW in v1 (no current equivalent)"
    }
  },
  "z": {
    "$type": "number",
    "base": { "$value": 0 },
    "sticky": { "$value": 5 },
    "dropdown": { "$value": 6 },
    "overlay": { "$value": 20 },
    "toast": { "$value": 30 }
  }
}
