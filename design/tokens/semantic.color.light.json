{
  "$description": "layer 2: semantic colour — light. Same keys in light and dark; only values differ.",
  "color": {
    "$type": "color",
    "bg": {
      "$value": "{color.raw.warm.18}",
      "$description": "page / app background"
    },
    "side": {
      "$value": "{color.raw.warm.39}",
      "$description": "sidebar — a step behind the page"
    },
    "side-hover": {
      "$value": "{color.raw.warm.55}",
      "$description": "sidebar row under the pointer — solid, so a title can fade into it"
    },
    "side-selected": {
      "$value": "{color.raw.warm.76}",
      "$description": "the open sidebar row — solid"
    },
    "surface": {
      "$value": "{color.raw.neutral.0}",
      "$description": "cards, sheets, fields (same as raised; desktop has no separate card fill)"
    },
    "raised": {
      "$value": "{color.raw.neutral.0}",
      "$description": "popovers, menus, toasts-over-surface, selected segment"
    },
    "sunken": {
      "$value": "{color.raw.warm.42}",
      "$description": "code, pressed wells, progress tracks (desktop code_bg)"
    },
    "popover": {
      "$value": "{color.raw.neutral.0}",
