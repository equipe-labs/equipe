{
  "$description": "layer 3: component tokens. Every value is a reference to a semantic token (or a literal shape number); never a raw colour. Colour references stay live in CSS, so theme switching needs no component rebuild.",
  "button": {
    "height": {
      "$type": "dimension",
      "$value": "{size.button}"
    },
    "height-sm": {
      "$type": "dimension",
      "$value": "36px",
      "$extensions": {
        "im.equipe": {
          "platform": {
            "desktop": "24px"
          }
        }
      }
    },
    "padding-x": {
      "$type": "dimension",
      "$value": "20px",
      "$extensions": {
        "im.equipe": {
          "platform": {
            "desktop": "{space.3}",
            "ios": "{space.4}",
            "android": "{space.5}"
          }
        }
      }
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.control}"
    },
    "font": {
      "$type": "typography",
      "$value": "{type.label}"
    },
