{
  "$description": "layer 2: semantic, mode-independent (shape, size, type, motion). Platform differences are explicit under $extensions.im.equipe.platform.",
  "radius": {
    "$type": "dimension",
    "code": {
      "$value": "{radius.sm}",
      "$description": "inline code, small tags"
    },
    "control": {
      "$value": "{radius.md}",
      "$description": "buttons, fields, menus, rows",
      "$extensions": {
        "im.equipe": {
          "platform": {
            "ios": "{radius.lg}",
            "android": "{radius.lg}"
          }
        }
      }
    },
    "card": {
      "$value": "{radius.lg}",
      "$description": "cards, banners",
      "$extensions": {
        "im.equipe": {
          "platform": {
            "ios": "{radius.xl}",
            "android": "{radius.xl}"
          }
        }
      }
    },
    "sheet": {
      "$value": "{radius.xl}",
      "$description": "modal dialogs; mobile bottom-sheet top corners",
      "$extensions": {
        "im.equipe": {
          "platform": {
            "ios": "{radius.xxl}",
            "android": "{radius.xxl}"
          }
        }
      }
    },
    "chip": {
      "$value": "{radius.full}",
      "$description": "chips and badges (pill)"
    }
  },
  "size": {
    "$type": "dimension",
    "button": {
      "$value": "44px",
      "$description": "button height (md)",
      "$extensions": {
        "im.equipe": {
          "platform": {
            "desktop": "28px",
            "android": "48px"
          }
        }
