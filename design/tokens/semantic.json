      "$extensions": {
        "im.equipe": {
          "platform": {
            "ios": "16px",
            "android": "16px",
            "web-narrow": "16px"
          }
        }
      }
    },
    "breakpoint-narrow": {
      "$value": "640px",
      "$description": "web only"
    }
  },
  "type": {
    "$type": "typography",
    "$description": "Type roles. $value = web (>640px). Overrides: web-narrow (<=640), desktop (GPUI), ios (Dynamic Type textStyle; size = Large default, reference only), android (Material3 slot, sp). Apps keep the platform font (guideline 3.2).",
    "display": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "56px",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "60px",
        "letterSpacing": "-0.02em"
      },
      "$description": "hero / onboarding title",
      "$extensions": {
        "im.equipe": {
          "platform": {
            "web-narrow": {
              "fontFamily": "{font.family.sans}",
              "fontSize": "36px",
              "fontWeight": "{font.weight.bold}",
              "lineHeight": "38px",
              "letterSpacing": "-0.02em"
            },
            "desktop": {
              "fontFamily": "{font.family.sans}",
              "fontSize": "28px",
