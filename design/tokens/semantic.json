  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "{duration.120}",
        "$description": "hover fill, press, tooltip"
      },
      "base": {
        "$value": "{duration.160}",
        "$description": "popover, menu, chip"
      },
      "slow": {
        "$value": "{duration.200}",
        "$description": "dialog, sheet, a card or message arriving"
      },
      "slide": {
        "$value": "{duration.180}",
        "$description": "sidebar / panel sliding"
      },
      "toast": {
        "$value": "{duration.5000}",
        "$description": "a toast without an action stays this long; pauses on hover/focus"
      },
      "reduced": {
        "$value": "{duration.100}",
        "$description": "the only motion left under Reduce Motion: an opacity fade this short or shorter"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": "{easing.out-cubic}",
        "$description": "the one curve: quick to start, soft to land"
      },
      "soft": {
        "$value": "{easing.out-quint}",
        "$description": "panel slide only"
      }
    },
    "travel": {
      "$type": "dimension",
      "pop": {
        "$value": "4px"
      },
      "rise": {
        "$value": "6px"
      },
      "dialog": {
        "$value": "8px"
      },
      "reduced": {
        "$value": "0px",
        "$description": "under Reduce Motion every travel is 0"
      }
    }
  },
  "state": {
    "disabled-opacity": {
      "$type": "number",
      "$value": "{opacity.disabled}"
    }
  },
  "focus": {
    "$type": "dimension",
    "ring-width": {
      "$value": "2px"
    },
    "ring-offset": {
      "$value": "3px",
      "$extensions": {
        "im.equipe": {
          "platform": {
            "desktop": "2px"
          }
        }
      }
    }
  }
}