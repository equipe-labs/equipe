      "$extensions": {
        "im.equipe": {
          "platform": {
            "desktop": "20px"
          }
        }
      }
    },
    "grabber-width": {
      "$value": "36px"
    },
    "grabber-height": {
      "$value": "4px"
    }
  },
  "layout": {
    "$type": "dimension",
    "wrap": {
      "$value": "1040px",
      "$description": "web content max width"
    },
    "measure": {
      "$value": "680px",
      "$description": "reading column",
      "$extensions": {
        "im.equipe": {
          "platform": {
            "desktop": "600px"
          }
        }
      }
    },
    "column": {
      "$value": "720px",
      "$description": "desktop conversation column"
    },
    "gutter": {
      "$value": "24px",
