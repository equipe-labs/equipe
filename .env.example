# Members' model and Nemotron review on Nebius Token Factory (see README.md). equipe reads these
# from the environment only — it never loads this file. Copy what you need into
# your shell; never commit a filled-in copy (.env is git-ignored).

# Your Token Factory API key. Required for `equipe review` and for the daemon's reviews.
NEBIUS_API_KEY=

# Optional: a model id. Unset, equipe picks an NVIDIA Nemotron model from GET /models.
EQUIPE_NEBIUS_MODEL=

# Optional: another server with the same API (default https://api.tokenfactory.nebius.com/v1/).
EQUIPE_NEBIUS_BASE_URL=

# Optional: the longest answer asked for, in tokens (default 2048).
EQUIPE_NEBIUS_MAX_TOKENS=

# Optional: the API members' turns are asked in: chat (default) or responses.
EQUIPE_NEBIUS_WIRE=

# ── Or any other server speaking OpenAI's Chat Completions API ──
# (OpenRouter, Together, Groq, vLLM, Ollama, LM Studio…). Set, it is used in place of Token Factory.
# Its API's root, e.g. https://openrouter.ai/api/v1 or http://localhost:11434/v1
EQUIPE_MODEL_BASE_URL=
# Its key (a server on this machine needs none).
EQUIPE_MODEL_API_KEY=
# Optional: the model id; unset, a Nemotron model if listed, else the first one listed.
EQUIPE_MODEL=
# Optional: chat (default) or responses; the longest review asked for.
EQUIPE_MODEL_WIRE=
EQUIPE_MODEL_MAX_TOKENS=
