// equipe project config — the shape Phase 2's orchestrator will read.
// Not read by the CLI yet.
{
  // Project slug for this squad's workspace.
  "project": "my-app",

  // Absolute path to the git repo the squad builds in.
  "repo": "/absolute/path/to/your/repo",

  // Default engine when a role doesn't override it.
  //   codex       — your ChatGPT plan; equipe signs in (`equipe login codex`)
  //   claude-code — your installed Claude Code; it signs itself in
  "defaultEngine": {
    "backend": "codex",
    // Omit to use the engine's default (Codex: the account's top-ranked model).
    "model": null
  },

  // Per-role overrides, e.g. a reviewer on a different model family.
  "roleEngines": {
    "qa": { "backend": "claude-code" }
  },

  // Which roles are active for this project.
  "roles": ["po", "designer", "frontend", "backend", "qa", "devops"],

  // Statuses that pause for human approval before advancing.
  "approvalGates": ["in_review"]
}
